# ========== demo-data 分支专用 .gitignore ==========

# 忽略常见临时/环境文件
__pycache__/
*.pyc
*.pyo
*.pyd
*.log
*.swp
*.tmp
*.bak
.DS_Store

# 忽略虚拟环境
.venv/
venv/
env/
ENV/

# 忽略本地数据库或缓存（但保留 chroma_store）
db/
.ingest.ckpt
*.sqlite3

# 忽略原始大数据
data/
!data/guidelines.parsed.jsonl   # 如果需要保留小样本

# 允许提交完整 Chroma 库（与 main 不同）
!chroma_store/**


.streamlit/secrets.toml
