# ========== demo-data branch .gitignore ==========

# Python / editor noise
__pycache__/
*.pyc
*.pyo
*.pyd
*.log
*.swp
*.tmp
*.bak
.DS_Store

# Virtual environments
.venv/
venv/
env/
ENV/

# Secrets (never commit)
.env
.streamlit/secrets.toml

# Raw source data (optional to ship)
data/
!data/guidelines.parsed.jsonl

# DBs: ship the demo drug DB, ignore others
db/*.sqlite
db/*.sqlite3
!db/drugs.sqlite

# Chroma: ship ONLY the active demo store folder
!chroma_store/**

# Avoid doubling repo size: do not commit backups/variants
chroma_store_clean/
chroma_store_quarantined_*/
chroma_store_sqlite_legacy/

# Local tools / scratch
tools/
demo.py
CompareRequirements.py
fullRequirements.txt

# Legacy / internal notes
ingest/create_db.py
rag/prompt_legacy.py

# Keep Chinese variants locally but do not commit
*_cn.py
!rag/prompt_cn.py