# ==============================
# CareMind Project - .env.example
# Copy this file to ".env" and replace placeholders with your own values
# ==============================

# ==============================
# REQUIRED
# ==============================

# 📚 Embedding model (Chinese optimized, via Hugging Face or local cache)
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# 🗂 Chroma vector database path
CHROMA_PERSIST_DIR=./chroma_store

# 🗄 SQLite database path (for drug info storage)
SQLITE_PATH=./db/drugs.sqlite

# ==============================
# OPTIONAL (only if you want these features)
# ==============================

# 🔑 Hugging Face API token (only needed if pulling private/remote models from Hugging Face Hub)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# 🔑 OpenAI API key (only needed if using OpenAI’s hosted models like GPT-4/3.5)
OPENAI_API_KEY=your_openai_api_key_here

# ⚙️ Local LLM / Ollama (optional; used only if running Ollama locally)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2:7b-instruct
